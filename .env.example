# GEMINI_API_KEY: Required for Gemini AI API calls (Optional now).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Lead Capture
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
